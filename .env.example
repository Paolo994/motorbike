# Copia questo file in .env (escluso da git) e imposta i valori.
# docker compose legge .env automaticamente.

# Password dell'utente "admin" creato al primo avvio. Se vuota, l'admin non viene creato.
ADMIN_PASSWORD=

# Porta su cui l'app è esposta sul PC (e sulla rete locale).
APP_PORT=8080

# Indirizzo con cui gli altri dispositivi raggiungono l'app: viene usato nei link delle email.
# Per l'accesso dalla rete Wi-Fi usa l'IP del PC, es. http://192.168.1.10:8080
APP_BASE_URL=http://localhost:8080

# Modalità AI: consigli di alloggi, cose da vedere e ristoranti per ogni tappa.
# true per accenderla; servono entrambe le chiavi qui sotto.
AI_ENABLED=false
# Modello Claude (default claude-opus-5-5)
AI_MODEL=claude-opus-5-5
# Chiave API di Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Chiave Google Maps Platform con "Places API (New)" abilitata
GOOGLE_PLACES_API_KEY=
